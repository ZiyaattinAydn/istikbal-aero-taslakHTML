{
  "name": "istikbal-aerospace",
  "version": "0.1.0",
  "private": true,
  "description": "İstikbal Aerospace Next.js web application.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests next.config.ts playwright.config.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "preview": "node scripts/preview.mjs",
    "test:browser": "playwright test",
    "cms:inventory": "tsx scripts/cms/inventory.ts",
    "cms:inventory:check": "tsx scripts/cms/inventory.ts --check",
    "cms:snapshots:check": "tsx scripts/cms/snapshot.ts --check",
    "cms:seed:check": "tsx scripts/cms/seed.ts --check"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "parse5": "8.1.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.4"
    }
  }
}
